NODE_ENV=development
PORT=8787
BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=/var/lib/moqian/auth.sqlite
BLOG_CONTENT_ROOT=/srv/moqian-content/blog
NOTE_CONTENT_ROOT=/srv/moqian-content/note
TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:3001,http://127.0.0.1:8080,http://127.0.0.1:3000,http://127.0.0.1:3001,https://moqian.me,https://note.moqian.me
UPLOAD_MAX_FILES=32
UPLOAD_MAX_MARKDOWN_BYTES=2097152
UPLOAD_MAX_IMAGE_BYTES=10485760
UPLOAD_MAX_TOTAL_BYTES=52428800
UPLOAD_MAX_IMAGE_PIXELS=40000000
UPLOAD_ATTEMPTS_PER_HOUR=10
CSRF_TTL_SECONDS=300

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
