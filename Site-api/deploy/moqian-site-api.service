[Unit]
Description=Moqian identity and content API
After=network.target

[Service]
Type=simple
User=moqian-api
Group=moqian-api
WorkingDirectory=/srv/moqian/Site-api
Environment=NODE_ENV=production
EnvironmentFile=/etc/moqian/site-api.env
ExecStart=/usr/bin/node /srv/moqian/Site-api/dist/server.js
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/moqian /srv/moqian-content/blog /srv/moqian-content/note

[Install]
WantedBy=multi-user.target
